# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Server-side Google Maps Platform key (Routes API & Places API New)
GOOGLE_MAPS_API_KEY=

# VITE_GOOGLE_MAPS_API_KEY: Browser Google Maps JavaScript API key (restricted to HTTP referrers)
VITE_GOOGLE_MAPS_API_KEY=

# Supabase browser client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ADMIN_EMAIL: Initial admin email for Pinnacle admin panel
ADMIN_EMAIL=mayurkorade276@gmail.com

# OWNER_EMAIL: Hospital Desk owner email with exclusive Hospital Desk access
OWNER_EMAIL=swapnilkorade0203@gmail.com

# SPONSOR_PRICE_RANK1: Price in INR for Sponsored Slot Rank 1 (top placement)
SPONSOR_PRICE_RANK1=999

# SPONSOR_PRICE_RANK2: Price in INR for Sponsored Slot Rank 2 (second placement)
SPONSOR_PRICE_RANK2=699

# SPONSOR_DURATION_MINUTES: Sponsorship validity duration in minutes (10080 = 7 days; set to 5 for quick demo)
SPONSOR_DURATION_MINUTES=10080

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Razorpay Test Mode credentials (server keeps secret private)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# DEMO_PAYMENT: Set to "true" to force built-in mock UPI/Card checkout even when Razorpay keys are set
DEMO_PAYMENT=false
